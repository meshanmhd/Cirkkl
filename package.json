{
  "name": "cirkkl",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" build",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" --if-present lint",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
